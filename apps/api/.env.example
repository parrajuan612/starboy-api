APP_ENV=development
# Proxies de confianza para leer la IP real (X-Forwarded-For). Local: Next corre en esta máquina.
# En producción pon las IP/CIDR de Caddy y de Next (red de Docker), nunca 0.0.0.0/0.
TRUSTED_PROXIES=127.0.0.1/32,::1/128
HTTP_PORT=8080

DB_HOST=localhost
DB_PORT=5434
DB_USER=starboy
DB_PASSWORD=starboy_pass
DB_NAME=starboy_db
DB_SSLMODE=disable
DB_TIMEZONE=America/Bogota
DB_AUTO_MIGRATE=true
DB_LOG_SQL=true

SEED_ADMIN_EMAIL=admin@starboy.local
SEED_ADMIN_PASSWORD=una-clave-larga-segura
SEED_ADMIN_NAME=Administrador Starboy

JWT_ACCESS_SECRET=cambia-esto-por-un-secreto-aleatorio-de-32-o-mas-caracteres
JWT_REFRESH_SECRET=cambia-esto-por-otro-secreto-distinto-de-32-o-mas-caracteres
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

PAYMENT_WEBHOOK_SECRET=cambia-esto-por-un-secreto-aleatorio-de-32-o-mas-caracteres
WEB_BASE_URL=http://localhost:3000
