# URL de la API de Go a la que Next reenvía /api/v1/* (servidor; no llega al navegador).
API_URL=http://localhost:8082

# Redes del footer (solo se muestran las que tengan valor). Confirmar las cuentas reales antes de lanzar.
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/starboy.streetwear
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Hosts externos a los que se permite mandar al cliente a pagar (la pasarela real), separados por coma. Vacío = solo la pasarela de pruebas.
# Ej.: NEXT_PUBLIC_PAYMENT_HOSTS=www.mercadopago.com.co
NEXT_PUBLIC_PAYMENT_HOSTS=
